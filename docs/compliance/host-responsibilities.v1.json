{
    "schema_version": "1.0",
    "contract": "fliix-cloud/filament-accounting-host-responsibilities",
    "version": "1.0.0",
    "status": "required-for-reference-operation",
    "controls": [
        {
            "id": "HOST-IAM-01",
            "required": true,
            "responsible_role": "host-security-owner",
            "objective": "Use personal privileged identities, MFA, least privilege, logged emergency access, and periodic access recertification.",
            "evidence": ["identity-provider-policy", "quarterly-access-review", "emergency-access-log"]
        },
        {
            "id": "HOST-DB-01",
            "required": true,
            "responsible_role": "database-owner",
            "objective": "Separate runtime, migration, backup, and administration roles and restrict direct mutation of immutable accounting evidence.",
            "evidence": ["database-role-grants", "direct-sql-control-test", "privileged-access-log"]
        },
        {
            "id": "HOST-EVD-01",
            "required": true,
            "responsible_role": "evidence-storage-owner",
            "objective": "Operate private versioned/object-locked evidence storage and an audit-chain anchor outside the application database with separately controlled credentials.",
            "evidence": ["storage-capability-report", "object-lock-policy", "anchor-verification-report", "key-access-review"]
        },
        {
            "id": "HOST-BCK-01",
            "required": true,
            "responsible_role": "continuity-owner",
            "objective": "Back up database, originals, anchors, keys, and procedural documentation in encrypted separate storage and prove restoration quarterly.",
            "evidence": ["backup-policy", "quarterly-restore-report", "annual-business-recovery-report", "rpo-rto-approval"]
        },
        {
            "id": "HOST-TIM-01",
            "required": true,
            "responsible_role": "platform-owner",
            "objective": "Synchronize UTC clocks, monitor drift, and retain each legal entity's business timezone.",
            "evidence": ["time-synchronization-configuration", "clock-drift-monitor", "time-incident-records"]
        },
        {
            "id": "HOST-MON-01",
            "required": true,
            "responsible_role": "operations-owner",
            "objective": "Monitor integrity verification, evidence loss, sequence gaps, import/replay failures, privileged changes, and backup/restore failures through incident closure.",
            "evidence": ["alert-rules", "on-call-procedure", "incident-register", "control-execution-history"]
        },
        {
            "id": "HOST-REL-01",
            "required": true,
            "responsible_role": "release-owner",
            "objective": "Deploy only reviewed, reproducibly identified releases with migration, dependency, configuration schema, SBOM, and artifact hashes.",
            "evidence": ["release-manifest", "ci-attestation", "review-record", "verified-release-tag", "deployment-record"]
        },
        {
            "id": "HOST-LOC-01",
            "required": true,
            "responsible_role": "data-governance-owner",
            "objective": "Document processing/storage locations, subprocessors, data flows, and any required authorization for operation outside Germany or the EU.",
            "evidence": ["data-location-register", "subprocessor-register", "data-flow-diagram", "legal-approval-if-applicable"]
        }
    ],
    "exception_fields": [
        "owner",
        "affected_legal_entities",
        "affected_periods",
        "compensating_controls",
        "approval",
        "expires_at",
        "evidence_reference"
    ]
}
